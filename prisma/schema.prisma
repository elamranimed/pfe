generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id_user  Int       @id @default(autoincrement())
  nom      String    @db.VarChar(255)
  prenom   String    @db.VarChar(255)
  role     Role
  email    String    @unique @db.VarChar(255)
  login    String    @unique @db.VarChar(255)
  password String    @db.VarChar(255)
  Demande  Demande[]
  bureaux  Bureau[]  @relation("UserBureau")
}

model Bureau {
  id_bureau  Int        @id @default(autoincrement())
  nom        String?    @db.VarChar(255)
  etage      Int
  telephone  String?    @db.VarChar(255)
  email      String?    @db.VarChar(255)
  type       Type
  statut     Statut
  cotisation Int
  numero     Int
  Demande    Demande[]
  Paiement   Paiement[]
  users      User[]     @relation("UserBureau")
}

model Demande {
  id_demande Int       @id @default(autoincrement())
  objet      Objet
  created_at DateTime? @default(now()) @db.Timestamp(6)
  created_by String    @db.VarChar(255)
  sujet      String?   @db.Text
  bureauid   Int?
  userid     Int?
  Bureau     Bureau?   @relation(fields: [bureauid], references: [id_bureau], onDelete: NoAction, onUpdate: NoAction)
  User       User?     @relation(fields: [userid], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
}

model Paiement {
  id_paiement Int       @id @default(autoincrement())
  montant     Int
  date        DateTime? @default(now()) @db.Timestamp(6)
  id_bureau   Int
  etat        String?   @db.VarChar(255)
  Bureau      Bureau    @relation(fields: [id_bureau], references: [id_bureau], onDelete: NoAction, onUpdate: NoAction)
}

model Expense {
  id_expense  Int      @id @default(autoincrement())
  date        DateTime @db.Date
  category    String
  description String
  provider    String
  amount      Float
}

enum Role {
  admin
  responsable
}

enum Objet {
  creation
  reclamation
}

enum Type {
  individuel
  centre
}

enum Statut {
  actif
  inactif
}
