{
  "name": "syndic-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:client": "npm run dev --workspace=client",
    "start:server": "npm run start:dev --workspace=server",
    "dev": "concurrently \"npm run start:client\" \"npm run start:server\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0" 
  }
}